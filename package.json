{
  "name": "turbo-pascal-ide",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:reference": "bun tests/reference/run.ts",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test:visual": "playwright test --project=visual",
    "test:e2e:update": "playwright test --project=visual --update-snapshots",
    "test:fidelity": "playwright test --project=fidelity",
    "fidelity:fetch": "bun tests/e2e/fidelity/fetch.ts",
    "fidelity:report": "bun tests/e2e/fidelity/report.ts",
    "fpc-suite:fetch": "bun tests/fpc-suite/fetch.ts",
    "test:fpc-suite": "bun tests/fpc-suite/run.ts",
    "test:fpc-suite:update": "FPC_SUITE_UPDATE=1 bun tests/fpc-suite/run.ts"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.10.0",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.97.0",
    "dexie": "^4.0.10",
    "emulators": "8.4.2",
    "fflate": "0.8.2",
    "i18next": "^24.2.2",
    "immer": "^10.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.50.1",
    "@stylexjs/babel-plugin": "^0.10.0",
    "@stylexjs/rollup-plugin": "^0.10.0",
    "@tanstack/router-devtools": "^1.97.0",
    "@tanstack/router-plugin": "^1.97.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  }
}
